# CRIT-SPARE - Environment Configuration Template
# Copy this file to .env or use js/firebase-config.example.js for client configuration.
# Never commit real credentials, service account keys, or API tokens to version control.

# Firebase Web App Configuration
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=critical-alert-inventory
FIREBASE_STORAGE_BUCKET=critical-alert-inventory.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_web_app_id

# Server / Local Environment Configuration
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000

